# Скопируй этот файл в .env и впиши свои значения

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-token-here

# Твой chat_id (как узнать — в README.md)
TELEGRAM_CHAT_ID=123456789

# ID пикселя Meta (Facebook/Instagram). Пока нет — оставь пустым
META_PIXEL_ID=

# Демо-режим: 1 (по умолчанию) — заявки никуда не уходят; 0 — настоящие продажи
DEMO_MODE=1
